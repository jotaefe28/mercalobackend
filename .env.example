# Variables de Entorno - MercaloPOS Backend
# Copiar este archivo como .env y configurar con tus valores

# ==============================================
# CONFIGURACIÓN DEL SERVIDOR
# ==============================================
NODE_ENV=development
PORT=3000

# ==============================================
# CONFIGURACIÓN DE BASE DE DATOS
# ==============================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mercalopos_db
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql

# ==============================================
# CONFIGURACIÓN JWT Y SEGURIDAD
# ==============================================
# Genera secrets seguros con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=tu_session_secret_muy_seguro_de_al_menos_64_caracteres
REFRESH_TOKEN_SECRET=tu_refresh_token_secret_diferente_y_muy_seguro
JWT_SECRET=tu_jwt_secret_muy_seguro_de_al_menos_64_caracteres
JWT_EXPIRATION=1h

# ==============================================
# CONFIGURACIÓN CORS
# ==============================================
# Orígenes permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ==============================================
# CONFIGURACIÓN DE LOGGING
# ==============================================
LOG_LEVEL=info

# ==============================================
# RATE LIMITING
# ==============================================
# Autenticación (más restrictivo)
AUTH_RATE_LIMIT_WINDOW=900000
AUTH_RATE_LIMIT_MAX=5

# API General
API_RATE_LIMIT_WINDOW=60000
API_RATE_LIMIT_MAX=100

# Ventas (operación crítica)
SALES_RATE_LIMIT_WINDOW=60000
SALES_RATE_LIMIT_MAX=20

# ==============================================
# CONFIGURACIÓN DE COOKIES
# ==============================================
COOKIE_SECRET=mercalopos_secure_cookie_secret_2024
COOKIE_MAX_AGE=86400000

# ==============================================
# CONFIGURACIÓN DE SEGURIDAD
# ==============================================
BCRYPT_SALT_ROUNDS=12

# ==============================================
# CONFIGURACIÓN DE API
# ==============================================
API_BASE_URL=http://localhost:3000

# ==============================================
# CONFIGURACIÓN DE REDIS (OPCIONAL)
# ==============================================
# Para cache y sesiones (si está disponible)
REDIS_PASSWORD=